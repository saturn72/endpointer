# Infrastructure Services

# PostgreSQL for apps/web (Command side)
POSTGRES_WEB_USER=endpointer_web
POSTGRES_WEB_PASSWORD=change_this_password

# PostgreSQL for apps/api (Query side usage)
POSTGRES_API_USER=endpointer_api
POSTGRES_API_PASSWORD=change_this_password

# MongoDB for apps/api (Query side feeds)
MONGO_ROOT_USERNAME=endpointer_query
MONGO_ROOT_PASSWORD=change_this_password

# NATS (Message bus)
# No credentials needed for local development

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=endpointer_minio
MINIO_ROOT_PASSWORD=change_this_password