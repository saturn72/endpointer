# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=endpointer

# SeaweedFS S3 gateway
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-here
S3_SECRET_ACCESS_KEY=your-secret-key-here
S3_RAW_BUCKET=raw-uploads
S3_CONVERTED_BUCKET=converted-feeds

# Conversion-service webhook listener
# Port that the conversion-service HTTP server listens on for SeaweedFS
# filer push notifications. In docker-compose this stays internal; when
# running locally, update notification.toml endpoint to match.
WEBHOOK_ADDR=:8080

# Versioning-service webhook listener
# Port that the versioning-service HTTP server listens on for events
# forwarded by the conversion-service.
VERSIONING_WEBHOOK_ADDR=:8081

# URL that conversion-service uses to forward converted-feeds events to
# versioning-service. In docker-compose this is set automatically.
# When running both services locally, set this to http://localhost:8081/webhook.
VERSIONING_WEBHOOK_URL=http://localhost:8081/webhook

# Datafeed-service HTTP port (serves GET /{endpoint_name} responses)
# In docker-compose, host port 8082 maps to container port 8080.
DATAFEED_PORT=8080

# Base URL for the datafeed-service as seen from the browser.
# Used by the dashboard to generate "View Data" external links.
# In docker-compose the host port is 8082.
DATAFEED_SERVICE_URL=http://localhost:8082
DATAFEED_PORT=8080

# Dashboard identity (Casdoor OIDC). Client ID/secret come from the Casdoor application.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_CASDOOR_ISSUER=http://localhost:8000
AUTH_CASDOOR_ID=
AUTH_CASDOOR_SECRET=

# Base URL for the dashboard's server-side datafeed manager calls.
DATAFEED_MANAGER_URL=http://localhost:8083
DATAFEED_MANAGER_PORT=8080
# Shared secret the dashboard sends to the manager (Authorization: Bearer). Required; generate with `openssl rand -hex 32`.
MANAGER_SERVICE_TOKEN=
# Host port published by docker-compose; change it if 8083 is already taken.
DATAFEED_MANAGER_HOST_PORT=8083
